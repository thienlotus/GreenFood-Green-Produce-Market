{
	"info": {
		"_postman_id": "greenfood-shipping-crud-collection-with-tests",
		"name": "GreenFood - Test API Form Phi Van Chuyen (CRUD)",
		"description": "Bộ Collection kiểm thử API đầy đủ 4 phương thức GET, POST, PUT, DELETE kèm theo Test Scripts để Runner hiển thị PASSED xanh đẹp.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. GET - Lấy danh sách vùng giao hàng",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response returns success: true and data list\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"    pm.expect(jsonData.data).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "http://127.0.0.1:8000/api/shipping-zones",
					"protocol": "http",
					"host": [
						"127",
						"0",
						"0",
						"1"
					],
					"port": "8000",
					"path": [
						"api",
						"shipping-zones"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. POST - Thêm mới vùng giao hàng (Form Create)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Verify created shipping zone data\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"    pm.expect(jsonData.data).to.have.property('id');",
							"    pm.expect(jsonData.data.name).to.eql('Vùng Tây Bắc Đặc Biệt');",
							"    // Save ID for update/delete steps",
							"    pm.collectionVariables.set(\"created_zone_id\", jsonData.data.id);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Vùng Tây Bắc Đặc Biệt\",\n  \"provinces\": \"Lào Cai, Sa Pa, Lai Châu, Điện Biên\",\n  \"base_fee\": 45000,\n  \"extra_fee_per_kg\": 6000,\n  \"free_ship_minimum\": 600000,\n  \"estimated_days\": \"2-3 ngày\",\n  \"is_active\": true\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://127.0.0.1:8000/api/shipping-zones",
					"protocol": "http",
					"host": [
						"127",
						"0",
						"0",
						"1"
					],
					"port": "8000",
					"path": [
						"api",
						"shipping-zones"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. PUT - Cập nhật thông tin vùng giao hàng (Form Edit)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Verify updated fee and response message\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"    pm.expect(jsonData.data.base_fee).to.eql(35000);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Vùng Tây Bắc (Đã Cập Nhật Phí Khuyến Mãi)\",\n  \"base_fee\": 35000,\n  \"extra_fee_per_kg\": 5000,\n  \"estimated_days\": \"1-2 ngày\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://127.0.0.1:8000/api/shipping-zones/SZ001",
					"protocol": "http",
					"host": [
						"127",
						"0",
						"0",
						"1"
					],
					"port": "8000",
					"path": [
						"api",
						"shipping-zones",
						"SZ001"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. DELETE - Xóa vùng giao hàng",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Verify deletion message\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"    pm.expect(jsonData.message).to.include(\"xóa\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "http://127.0.0.1:8000/api/shipping-zones/{{created_zone_id}}",
					"protocol": "http",
					"host": [
						"127",
						"0",
						"0",
						"1"
					],
					"port": "8000",
					"path": [
						"api",
						"shipping-zones",
						"{{created_zone_id}}"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "created_zone_id",
			"value": "SZ002"
		}
	]
}
